# Web (Vercel): leave unset. The app calls /api on its own origin.
# Desktop (Tauri) and mobile (Capacitor) builds: the absolute API URL, e.g.
# VITE_API_BASE=https://humanproof.example/api
VITE_API_BASE=
# Local `npm run dev` only: where the /api proxy forwards to.
VITE_DEV_API_TARGET=http://localhost:8000
# Identifier of the app requesting verification (tokens are scoped to it).
VITE_RELYING_PARTY=humanproof
# Android: Google Cloud project number used for Play Integrity (Standard API).
VITE_PLAY_CLOUD_PROJECT=
