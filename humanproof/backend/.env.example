# Copy to .env (never commit it). Generate secrets with: python -m tools.genkeys --out ./secrets
HP_ENV=prod
HP_PUBLIC_BASE_URL=https://api.humanproof.example
# Path prefix the API is served under. Empty for a dedicated API host (Docker);
# /api when the web app and API share one domain (Vercel sets this automatically).
HP_API_PREFIX=
# Only on hosts whose edge sets this header itself (Vercel sets x-real-ip automatically).
HP_TRUSTED_IP_HEADER=
HP_ALLOWED_ORIGINS=["https://app.humanproof.example","capacitor://localhost","https://localhost","tauri://localhost","http://tauri.localhost"]
HP_RP_ID=humanproof.example
# --- keys: either one master secret (simplest) ... ---------------------------
# `openssl rand -base64 32` (or any random string of 32+ characters). Every other key is derived from it. Losing it makes
# stored data unreadable and already-issued proofs unverifiable; keep a backup.
HP_MASTER_SECRET=
# --- ... or the three separate keys (supports rotation; these override the master)
HP_KEK_KEYRING=
# kid:/path/to/key.pem, or kid:b64:<base64 PEM> where secrets are env vars only
HP_SIGNING_KEYS=
HP_PAIRWISE_SECRET=
# --- database -----------------------------------------------------------------
# Postgres connection string. Empty = a local SQLite file in HP_DATA_DIR.
# DATABASE_URL / POSTGRES_URL (set by Vercel storage integrations) is picked up too.
HP_DATABASE_URL=
HP_ASR_MODEL=base.en
HP_MODELS_DIR=/app/models
HP_DATA_DIR=/var/lib/humanproof
# iOS App Attest (also place Apple_App_Attestation_Root_CA.pem in HP_DATA_DIR)
HP_APPLE_TEAM_ID=
HP_APPLE_BUNDLE_ID=com.humanproof.app
# Android Play Integrity
HP_ANDROID_PACKAGE_NAME=com.humanproof.app
HP_GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/play-integrity.json
# --- storing verification data for training ------------------------------------
# Off by default. When on, data is stored only from people who tick the optional
# consent boxes, and from tester sessions started with the collection code.
HP_DATA_COLLECTION_ENABLED=false
# Private code (12+ characters) that lets a trusted tester label a session as
# "real human" or as a specific attack. Only labelled sessions train models.
HP_COLLECTION_KEY=
HP_DATA_RETENTION_DAYS=365
